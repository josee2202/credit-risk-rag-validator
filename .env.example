# Todas las variables son opcionales. Los valores por defecto están en IA-modulable/config/config.yaml.
# El backend lee este fichero si se copia como .env en la raíz o en IA-modulable/ (no se versiona).
# No hace falta ninguna API key: todo se ejecuta en local con Ollama y Qdrant.

# Servidor de Ollama
# OLLAMA_HOST_NAME=localhost
# OLLAMA_PORT=11434

# Modelos de Ollama
# EMBED_MODEL=nomic-embed-text
# LLM_MODEL=llama3.2:1b
# LLM_MAX_TOKENS=1024

# Qdrant: URL del servidor, ruta local (modo embebido, sin Docker) o :memory:
# QDRANT_LOCATION=http://localhost:6333
# QDRANT_LOCATION=./qdrant_storage

# Front-end (variable de entorno del proceso de Streamlit): URL del backend
# API_URL=http://localhost:8000
